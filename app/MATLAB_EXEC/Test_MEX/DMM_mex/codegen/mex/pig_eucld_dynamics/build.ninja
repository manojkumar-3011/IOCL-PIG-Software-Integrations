# CompilerName=lcc64
# Mode=optim
ninja_required_version = 1.3

# Basic folders
root = .
builddir = $root\build\win64
matlabdir = C:\Program Files\MATLAB\R2021b
startdir = F:\Academic\Dropbox\Recent\WorkQC\Experiment for 100km data\FSP_ver0r3_speed\Test_MEX\DMM_mex

# Toolchain information
cc = lcc64
cxx = 
linker = lcclnk64
linkerxx = 

cflags =  -nodeclspec -Zp8 -dll -c -I"$matlabdir\sys\lcc64\lcc64\include64" -DMATLAB_MEX_FILE -noregistrylookup -DNDEBUG -I"$root" -I"$startdir" -I"$root\interface" -I"$matlabdir\extern\include" -I"." -DMODEL=pig_dynamics_mex  

cxxflags =  -I"$root" -I"$startdir" -I"$root\interface" -I"$matlabdir\extern\include" -I"." -DMODEL=pig_dynamics_mex  

ldflags =  -dll -L"$matlabdir\sys\lcc64\lcc64\lib64" -L"$matlabdir\extern\lib\win64\microsoft" -entry LibMain libmx.lib libmex.lib libmat.lib libemlrt.lib libcovrt.lib libut.lib libmwmathutil.lib -o pig_dynamics_mex.mexw64 -s  pig_dynamics_mex.def

# Build Rules
rule cc
    command = $cc $cflags $in -Fo$out

rule cxx
    command = $cxx $cxxflags $in -Fo$out

rule link
    command = $linker $in $ldflags

rule linkxx
    command = $linkerxx $in $ldflags

# Build
build $builddir\pig_eucld_dynamics_data.obj : cc $root\pig_eucld_dynamics_data.c
build $builddir\rt_nonfinite.obj : cc $root\rt_nonfinite.c
build $builddir\pig_eucld_dynamics_initialize.obj : cc $root\pig_eucld_dynamics_initialize.c
build $builddir\pig_eucld_dynamics_terminate.obj : cc $root\pig_eucld_dynamics_terminate.c
build $builddir\pig_eucld_dynamics.obj : cc $root\pig_eucld_dynamics.c
build $builddir\expm.obj : cc $root\expm.c
build $builddir\warning.obj : cc $root\warning.c
build $builddir\_coder_pig_eucld_dynamics_api.obj : cc $root\interface\_coder_pig_eucld_dynamics_api.c
build $builddir\_coder_pig_eucld_dynamics_mex.obj : cc $root\interface\_coder_pig_eucld_dynamics_mex.c
build $builddir\sumMatrixIncludeNaN.obj : cc $root\sumMatrixIncludeNaN.c
build $builddir\eml_int_forloop_overflow_check.obj : cc $root\eml_int_forloop_overflow_check.c
build $builddir\_coder_pig_eucld_dynamics_info.obj : cc $root\interface\_coder_pig_eucld_dynamics_info.c
build $builddir\c_mexapi_version.obj : cc $matlabdir\extern\version\c_mexapi_version.c
build $builddir\lccstub.obj : cc $matlabdir\sys\lcc64\lcc64\mex\lccstub.c

# Link
build $root\pig_dynamics_mex.mexw64 : link $builddir\pig_eucld_dynamics_data.obj $builddir\rt_nonfinite.obj $builddir\pig_eucld_dynamics_initialize.obj $builddir\pig_eucld_dynamics_terminate.obj $builddir\pig_eucld_dynamics.obj $builddir\expm.obj $builddir\warning.obj $builddir\_coder_pig_eucld_dynamics_api.obj $builddir\_coder_pig_eucld_dynamics_mex.obj $builddir\sumMatrixIncludeNaN.obj $builddir\eml_int_forloop_overflow_check.obj $builddir\_coder_pig_eucld_dynamics_info.obj $builddir\c_mexapi_version.obj $builddir\lccstub.obj 
