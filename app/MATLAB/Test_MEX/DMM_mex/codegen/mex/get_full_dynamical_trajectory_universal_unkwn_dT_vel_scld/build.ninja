# CompilerName=gcc
# Mode=optim
ninja_required_version = 1.3

# Basic folders
root = .
builddir = $root/build/glnxa64
matlabdir = /usr/local/MATLAB/R2024a
startdir = /home/sidgirase/Documents/Project/FSP_ver0r4_sg_fork_toIOCL/Test_MEX/DMM_mex

# Toolchain information
cc = /usr/bin/gcc
cxx = g++
linker = /usr/bin/gcc
linkerxx = g++

cflags =  -fexceptions -fPIC -fno-omit-frame-pointer -pthread -fwrapv -D_GNU_SOURCE -DMATLAB_MEX_FILE  -O2 -DNDEBUG -std=c99 -I "$root" -I "$startdir" -I "$root/interface" -I "$matlabdir/extern/include" -I "." -DHAVE_LAPACK_CONFIG_H -DLAPACK_COMPLEX_STRUCTURE -DMW_HAVE_LAPACK_DECLS -DMODEL=get_full_dynamical_trajectory_universal_unkwn_dT_vel_scld_mex -msse2 -fno-predictive-commoning -c 

cxxflags =  -fexceptions -fPIC -fno-omit-frame-pointer -pthread -fwrapv -D_GNU_SOURCE -DMATLAB_MEX_FILE  -O2 -DNDEBUG -std=c++11 -I "$root" -I "$startdir" -I "$root/interface" -I "$matlabdir/extern/include" -I "." -DHAVE_LAPACK_CONFIG_H -DLAPACK_COMPLEX_STRUCTURE -DMW_HAVE_LAPACK_DECLS -DMODEL=get_full_dynamical_trajectory_universal_unkwn_dT_vel_scld_mex -msse2 -fno-predictive-commoning -c 

ldflags =  -pthread -Wl,--no-undefined -Wl,-rpath-link,$matlabdir/bin/glnxa64 -shared  -L"$matlabdir/bin/glnxa64" -lmx -lmex -lmat -lm -lstdc++  -Wl,-Bsymbolic -o get_full_dynamical_trajectory_universal_unkwn_dT_vel_scld_mex.mexa64 -L"$matlabdir/bin/glnxa64" -lmwlapack -lemlrt -lcovrt -lut -lmwmathutil  -Wl,--version-script,get_full_dynamical_trajectory_universal_unkwn_dT_vel_scld_mex.map

linkobjs = 

# Build Rules
rule cc
    command = $cc $cflags $in -o $out

rule cxx
    command = $cxx $cxxflags $in -o $out

rule link
    command = $linker $in $linkobjs $ldflags

rule linkxx
    command = $linkerxx $in $linkobjs $ldflags

# Build
build $builddir/get_full_dynamical_trajectory_universal_unkwn_dT_vel_scld_data.o : cc $root/get_full_dynamical_trajectory_universal_unkwn_dT_vel_scld_data.c
build $builddir/rt_nonfinite.o : cc $root/rt_nonfinite.c
build $builddir/get_full_dynamical_trajectory_universal_unkwn_dT_vel_scld_initialize.o : cc $root/get_full_dynamical_trajectory_universal_unkwn_dT_vel_scld_initialize.c
build $builddir/get_full_dynamical_trajectory_universal_unkwn_dT_vel_scld_terminate.o : cc $root/get_full_dynamical_trajectory_universal_unkwn_dT_vel_scld_terminate.c
build $builddir/get_full_dynamical_trajectory_universal_unkwn_dT_vel_scld.o : cc $root/get_full_dynamical_trajectory_universal_unkwn_dT_vel_scld.c
build $builddir/quat2rotm.o : cc $root/quat2rotm.c
build $builddir/expm.o : cc $root/expm.c
build $builddir/norm.o : cc $root/norm.c
build $builddir/log2.o : cc $root/log2.c
build $builddir/warning.o : cc $root/warning.c
build $builddir/_coder_get_full_dynamical_trajectory_universal_unkwn_dT_vel_scld_api.o : cc $root/interface/_coder_get_full_dynamical_trajectory_universal_unkwn_dT_vel_scld_api.c
build $builddir/_coder_get_full_dynamical_trajectory_universal_unkwn_dT_vel_scld_mex.o : cc $root/interface/_coder_get_full_dynamical_trajectory_universal_unkwn_dT_vel_scld_mex.c
build $builddir/sumMatrixIncludeNaN.o : cc $root/sumMatrixIncludeNaN.c
build $builddir/eml_int_forloop_overflow_check.o : cc $root/eml_int_forloop_overflow_check.c
build $builddir/get_full_dynamical_trajectory_universal_unkwn_dT_vel_scld_emxutil.o : cc $root/get_full_dynamical_trajectory_universal_unkwn_dT_vel_scld_emxutil.c
build $builddir/_coder_get_full_dynamical_trajectory_universal_unkwn_dT_vel_scld_info.o : cc $root/interface/_coder_get_full_dynamical_trajectory_universal_unkwn_dT_vel_scld_info.c
build $builddir/c_mexapi_version.o : cc $matlabdir/extern/version/c_mexapi_version.c

# Link
build $root/get_full_dynamical_trajectory_universal_unkwn_dT_vel_scld_mex.mexa64 : link $builddir/get_full_dynamical_trajectory_universal_unkwn_dT_vel_scld_data.o $builddir/rt_nonfinite.o $builddir/get_full_dynamical_trajectory_universal_unkwn_dT_vel_scld_initialize.o $builddir/get_full_dynamical_trajectory_universal_unkwn_dT_vel_scld_terminate.o $builddir/get_full_dynamical_trajectory_universal_unkwn_dT_vel_scld.o $builddir/quat2rotm.o $builddir/expm.o $builddir/norm.o $builddir/log2.o $builddir/warning.o $builddir/_coder_get_full_dynamical_trajectory_universal_unkwn_dT_vel_scld_api.o $builddir/_coder_get_full_dynamical_trajectory_universal_unkwn_dT_vel_scld_mex.o $builddir/sumMatrixIncludeNaN.o $builddir/eml_int_forloop_overflow_check.o $builddir/get_full_dynamical_trajectory_universal_unkwn_dT_vel_scld_emxutil.o $builddir/_coder_get_full_dynamical_trajectory_universal_unkwn_dT_vel_scld_info.o $builddir/c_mexapi_version.o 
